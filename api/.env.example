MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/finanzas
JWT_SECRET=change-me-at-least-16-chars
PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_EXPIRES_IN=7d

# --- Production / hardening (see docs/SECURITY.md) ---
# NODE_ENV=production turns on strict checks at startup: JWT_SECRET of 32+
# characters (not the example), CORS_ORIGIN as an https:// URL, and
# NODE_TLS_REJECT_UNAUTHORIZED must not be 0.
NODE_ENV=development
# Set to "false" (the exact word) to close POST /auth/register once your own
# account exists. Anything else keeps it open.
ALLOW_REGISTRATION=true
# Requests per minute per IP: whole API, and login/register.
RATE_LIMIT=100
AUTH_RATE_LIMIT=10
